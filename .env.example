# ===========================================
# LiveKit Server
# ===========================================
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=your_api_key_here
LIVEKIT_API_SECRET=your_api_secret_here

# ===========================================
# Auth-translating gateway (issued API keys)
# ===========================================
# The LiveKit server only knows the single key pair above — it reads its keys
# once at boot. Keys generated in Settings > API keys are therefore validated by
# the gateway (`npm run gateway`), which verifies them against the database and
# re-signs the token with the real key before forwarding.
#
# Port the gateway listens on. Default: 7885
GATEWAY_PORT=7885
# URL handed out alongside generated keys. Must point at the gateway, NOT at the
# LiveKit server, or generated keys will be rejected.
NEXT_PUBLIC_LIVEKIT_GATEWAY_URL=ws://localhost:7885
# Set to 1 to log every translated request (useful when debugging a key)
# GATEWAY_VERBOSE=1
# 32 bytes of hex encrypting issued key secrets at rest. Falls back to deriving
# a key from SESSION_SECRET — set explicitly in production, and note that
# changing either value makes existing issued keys unreadable.
# API_KEYS_ENC_KEY=

# ===========================================
# Database Configuration
# ===========================================
# Supported: "sqlite" | "postgres"
# Default: sqlite
DB_TYPE=sqlite

# --- SQLite (default) ---
# Path to the SQLite database file (relative to project root)
SQLITE_PATH=./data/livekit.db

# --- PostgreSQL ---
# Uncomment and fill in to use PostgreSQL instead of SQLite
# DB_TYPE=postgres
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=livekit
# POSTGRES_PASSWORD=your_password_here
# POSTGRES_DB=livekit
# Or use a connection string instead:
# DATABASE_URL=postgresql://livekit:your_password_here@localhost:5432/livekit

# ===========================================
# Session
# ===========================================
# Secret used to generate session tokens (change in production)
SESSION_SECRET=change-me-to-a-random-secret

# ===========================================
# Sandbox
# ===========================================
# Base URL for sandbox apps. Sandboxes are proxied at {domain}/sandbox/{name}
# Default: http://localhost:3000
NEXT_PUBLIC_SANDBOX_DOMAIN=http://localhost:3000

# ===========================================
# Agent deployment
# ===========================================
# Python interpreter that deployed agents run in. Defaults to
# example/agent-starter-python/venv (or .venv). It must have livekit-agents
# plus a plugin for every provider you use — see "Setting Up Examples" in the
# README. Set this to use an interpreter elsewhere.
# AGENT_PYTHON_BIN=/path/to/python3

# ===========================================
# Webhooks (optional)
# ===========================================
# URL that LiveKit server sends events to (room started, participant joined, etc.)
# LIVEKIT_WEBHOOK_URL=https://your-domain.com/api/webhooks/livekit

# ===========================================
# Telephony Providers (optional)
# ===========================================
# Configure one or more providers to import phone numbers.
# Numbers can always be added manually without any provider.

# --- Twilio ---
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token_here

# --- Vonage (Nexmo) ---
# VONAGE_API_KEY=your_api_key
# VONAGE_API_SECRET=your_api_secret

# --- Telnyx ---
# TELNYX_API_KEY=KEY_your_api_key_here
