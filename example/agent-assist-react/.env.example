# The dashboard writes .env.local when it deploys this sandbox. These are the
# values it writes, for running the template by hand.

# Browser-facing address. Behind TLS this must be wss:// — an https page cannot
# open a ws:// socket.
LIVEKIT_URL=ws://localhost:7880

# Server-to-server address, used for listing participants (the join screen's
# "seat taken" check). Falls back to LIVEKIT_URL when unset, which is right for
# local development and wrong under Docker, where the public hostname may not
# resolve from inside the container.
LIVEKIT_SERVER_URL=http://localhost:7880

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Assist worker to dispatch by name. Empty means no worker joins — the two humans
# can still talk, but nothing transcribes them.
AGENT_NAME=

# Names the default room (`assist-<SANDBOX_NAME>`), so both people reach the same
# call from the same link. `?room=<slug>` overrides it per visit.
SANDBOX_NAME=local
