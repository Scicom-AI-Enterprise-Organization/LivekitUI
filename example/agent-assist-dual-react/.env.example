# The dashboard writes .env.local when it deploys this sandbox. These are the
# values it writes, for running the template by hand.

# Browser-facing address. Behind TLS this must be wss:// — an https page cannot
# open a ws:// socket, and the browser reports it as a WebSocket SecurityError
# rather than anything that looks like a URL problem.
LIVEKIT_URL=ws://localhost:7880

# Server-to-server address, used for listing what is on air in the room. Falls
# back to LIVEKIT_URL when unset, which is right for local development and wrong
# under Docker, where the public hostname may not resolve from inside the
# container.
LIVEKIT_SERVER_URL=http://localhost:7880

LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# The dual-track worker to dispatch by name. Empty means no worker joins — the
# desk can still publish both legs, but nothing transcribes them.
AGENT_NAME=

# Names the default room (`dual-<SANDBOX_NAME>`). `?room=<slug>` overrides it per
# visit, which is how several desks run side by side against one sandbox — one
# room each, since a room holds one call.
SANDBOX_NAME=local
