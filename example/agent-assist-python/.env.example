# Copy to .env.local. When the dashboard deploys this worker it writes these
# itself (from Settings → Providers and Settings → Secrets), so this file is for
# running it by hand.

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── Dispatch ────────────────────────────────────────────────────────────────
# The name clients request in their token's roomConfig. Nothing joins a room
# unless something dispatches it by this name.
ASSIST_AGENT_NAME=agent-assist

# ── Transcription ───────────────────────────────────────────────────────────
# Any livekit.plugins.<plugin>.STT. Only kwargs the plugin accepts are passed,
# so base_url on a plugin that has no such argument is ignored, not an error.
ASSIST_STT_PLUGIN=openai
ASSIST_STT_MODEL=whisper-1
ASSIST_STT_BASE_URL=
# Name of the env var holding the key — not the key itself.
ASSIST_STT_API_KEY_ENV=OPENAI_API_KEY
# Blank lets the provider auto-detect.
ASSIST_LANGUAGE=

# `audio` (default) runs LiveKit's own end-of-turn model in-process; its weights
# ship with livekit-agents, so there is nothing to download and no Cloud account.
# `livekit` is the older text detector (needs `python -m livekit.agents
# download-files`), `scicom` forwards each prediction to a vLLM endpoint
# (LIVEKIT_REMOTE_EOT_URL), `none` falls back to plain VAD silence.
ASSIST_TURN_DETECTOR=audio
LIVEKIT_REMOTE_EOT_URL=

# `gtcrn` runs a 48 K-parameter ONNX denoiser per stream inside this process.
# `none` disables it. Krisp is deliberately not an option: self-hosted it logs
# `not authorized (404)` and passes audio through untouched.
ASSIST_NOISE_CANCELLATION=gtcrn

# Audio handed to the filter per call, and from there to the VAD and the STT.
# 50 ms is the SDK's default: 800 samples at 16 kHz, twenty calls a second per
# speaker. Smaller reaches the filter sooner at proportionally more calls; larger
# buffers longer before anything downstream sees the audio. It does not change how
# GTCRN works — always 256-sample hops through a 512-point window, 32 ms of delay.
ASSIST_AUDIO_CHUNK_MS=50

# Publish partial transcripts as they arrive, not just completed turns.
ASSIST_INTERIM_TRANSCRIPTS=true

# ── Coaching ────────────────────────────────────────────────────────────────
ASSIST_LLM_PLUGIN=openai
ASSIST_LLM_MODEL=gpt-4o-mini
ASSIST_LLM_BASE_URL=
ASSIST_LLM_API_KEY_ENV=OPENAI_API_KEY

# Whose finished turn triggers a suggestion: `customer`, `agent`, or `off`.
ASSIST_SUGGEST_FOR=customer
# Turns of transcript sent with each request.
ASSIST_HISTORY_TURNS=12
# Overrides the built-in coaching prompt.
ASSIST_INSTRUCTIONS=

OPENAI_API_KEY=
