# The dashboard writes .env.local when it deploys this worker. These are the
# values it writes, for running it by hand.

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# The dispatch name the sandbox asks for. Must match, or the worker registers and
# no job ever reaches it.
DUAL_AGENT_NAME=agent-assist-dual

# ── Which track is whose ─────────────────────────────────────────────────────
# Track *name* decides first: a publication whose name contains "agent" is the
# support agent, one containing "customer" is the caller. Only when the name says
# nothing does the source decide, and this is which role the Microphone-source
# track is then taken to be. On a real desk that is the support agent (their
# headset), with the caller arriving as screen-share audio from a softphone tab.
DUAL_MIC_ROLE=agent

# What to call each leg on screen. The publisher can override either per call
# through its participant attributes (`assistName`, `assistCustomerName`) — which
# is how a caller's number ends up on the transcript.
DUAL_AGENT_LABEL=Support agent
DUAL_CUSTOMER_LABEL=Customer

# ── Models ───────────────────────────────────────────────────────────────────
# One STT stream per leg, so a call costs two.
DUAL_STT_PLUGIN=openai
DUAL_STT_MODEL=whisper-1
DUAL_STT_BASE_URL=
# The *name* of the environment variable holding the key, not the key.
DUAL_STT_API_KEY_ENV=OPENAI_API_KEY

DUAL_LLM_PLUGIN=openai
DUAL_LLM_MODEL=gpt-4o-mini
DUAL_LLM_BASE_URL=
DUAL_LLM_API_KEY_ENV=OPENAI_API_KEY

# Blank lets the provider auto-detect. `multi`/`auto` mean the same thing here —
# they are builder-only values that providers answer with a 400 on every
# utterance, so they are translated to "send no language" rather than passed on.
DUAL_LANGUAGE=

# ── The audio path ───────────────────────────────────────────────────────────
# audio  — LiveKit v1-mini, runs in this process, weights ship with the SDK
# livekit — the multilingual text model (needs `download-files` in the venv)
# scicom  — a remote vLLM endpoint; set LIVEKIT_REMOTE_EOT_URL too
# none    — a turn ends after a VAD pause
DUAL_TURN_DETECTOR=audio
LIVEKIT_REMOTE_EOT_URL=

# gtcrn — a 48K-parameter ONNX denoiser per stream, inside this process
# none  — raw track audio
DUAL_NOISE_CANCELLATION=gtcrn

# Audio handed to the filter per call, and from there to the VAD and the STT.
# 50 ms is 800 samples at 16 kHz.
DUAL_AUDIO_CHUNK_MS=50

# Automatic gain control on the way in. Worth keeping on here: a phone leg
# re-captured through a screen share is routinely quieter than the headset beside
# it, and one loud speaker next to one quiet one is a VAD that never fires on
# half the call.
DUAL_AUTO_GAIN_CONTROL=true

# ── Turn shaping ─────────────────────────────────────────────────────────────
# Silero's defaults pad every utterance by about a second and send all of it to
# the recogniser. The prefix is nearly free to cut; the trailing silence is what
# *ends a turn*, and cutting it too far splits one sentence into two utterances,
# each paying for its own STT call and its own trip to the coach.
DUAL_VAD_PREFIX_PADDING=0.2
DUAL_VAD_MIN_SILENCE=0.5
DUAL_VAD_MIN_SPEECH=0.05
DUAL_VAD_ACTIVATION=0.5

# Partial transcripts, as the recogniser revises them.
DUAL_INTERIM_TRANSCRIPTS=true

# ── Coaching ─────────────────────────────────────────────────────────────────
# customer | agent | off — whose finished turn asks the model for a note.
DUAL_SUGGEST_FOR=customer
DUAL_HISTORY_TURNS=12

# Blank keeps the worker's built-in coaching prompt. The dashboard writes this
# JSON-quoted, which is how a multi-line prompt survives a one-pair-per-line file.
DUAL_INSTRUCTIONS=
